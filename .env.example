# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Password for /admin. Required to edit the site.
ADMIN_PASSWORD=
# Optional: separate secret for signing the admin cookie. Changing it signs everyone out.
ADMIN_SECRET=

# Supabase (Project Settings → API). When these are empty the app uses local files instead,
# which works on your computer but not on Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=portfolio

# Resend, for emailing you when someone uses the contact form. Optional.
RESEND_API_KEY=
# Sender. Use onboarding@resend.dev until you verify your own domain in Resend.
RESEND_FROM=Portfolio <onboarding@resend.dev>
# Where messages go. Defaults to the email in the Contact section.
CONTACT_TO_EMAIL=
